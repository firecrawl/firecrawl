{
  "name": "firecrawl-scraper-js",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/service/index.ts",
      "default": "./dist/src/service/index.js"
    },
    "./config": {
      "types": "./src/exports/config.ts",
      "default": "./dist/src/exports/config.js"
    },
