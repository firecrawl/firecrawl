  "scripts": {
    "start": "tsc && node dist/src/main.js harness --start-built",
    "dev": "tsx src/main.ts harness --start",
    "server": "tsc-watch --compiler ./node_modules/typescript-7/bin/tsc --onSuccess \"node dist/src/main.js api\"",
    "server:production": "tsc && node dist/src/main.js api",
    "server:production:nobuild": "node dist/src/main.js api",
    "format": "prettier --write \"src/**/*.(js|ts)\"",
    "flyio": "node dist/src/main.js api",
    "start:dev": "tsc-watch --compiler ./node_modules/typescript-7/bin/tsc --onSuccess \"node dist/src/main.js api\"",
    "build": "tsc",
    "test": "vitest run",
    "test:prod": "vitest run --exclude='**/scraper/scrapeURL/**'",
    "test:snips": "vitest run src/__tests__/snips/v1 src/__tests__/snips/v2",
    "test:core": "vitest run --config vitest.core.config.ts",
    "harness": "tsx src/main.ts harness",
    "workers": "tsc-watch --compiler ./node_modules/typescript-7/bin/tsc --onSuccess \"node dist/src/main.js queue-worker\"",
    "worker:production": "node dist/src/main.js queue-worker",
    "nuq-worker": "tsc-watch --compiler ./node_modules/typescript-7/bin/tsc --onSuccess \"node dist/src/main.js nuq-worker\"",
    "nuq-worker:production": "node dist/src/main.js nuq-worker",
    "nuq-fdb-worker": "tsc-watch --compiler ./node_modules/typescript-7/bin/tsc --onSuccess \"node dist/src/main.js nuq-fdb-worker\"",
    "nuq-fdb-worker:production": "node dist/src/main.js nuq-fdb-worker",
    "nuq-prefetch-worker": "tsc-watch --compiler ./node_modules/typescript-7/bin/tsc --onSuccess \"node dist/src/main.js nuq-prefetch-worker\"",
    "nuq-prefetch-worker:production": "node dist/src/main.js nuq-prefetch-worker",
    "nuq-reconciler-worker": "tsc-watch --compiler ./node_modules/typescript-7/bin/tsc --onSuccess \"node dist/src/main.js nuq-reconciler-worker\"",
    "nuq-reconciler-worker:production": "node dist/src/main.js nuq-reconciler-worker",
    "extract-worker": "tsc-watch --compiler ./node_modules/typescript-7/bin/tsc --onSuccess \"node dist/src/main.js extract-worker\"",
    "extract-worker:production": "node dist/src/main.js extract-worker",
    "prepare": "cd ../.. && husky ./apps/api/.husky",
    "knip": "knip"
  },
