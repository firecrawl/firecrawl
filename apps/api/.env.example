# ===== Required ENVS ======
PORT=3002
HOST=0.0.0.0
REDIS_URL=redis://redis:6379 # For self-hosting using Docker, use redis://redis:6379. For running locally, use redis://localhost:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379 # For self-hosting using Docker, use redis://redis:6379. For running locally, use redis://localhost:6379
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape

# ===== Optional ENVS ======

## === Concurrency & Performance Settings ===
# Number of worker processes per queue - controls parallel job processing
# Recommended: 4-8 for most setups, adjust based on CPU cores
NUM_WORKERS_PER_QUEUE=8
# Number of concurrent crawl requests/pages - increase for higher throughput
# Recommended: 8-16 for most setups, 32+ for high-performance servers
CRAWL_CONCURRENT_REQUESTS=10
# Maximum number of simultaneous crawl jobs
# Controls how many crawl operations can run at the same time
MAX_CONCURRENT_JOBS=5
# Size of browser instance pool for Playwright service
# Higher values allow more parallel browser operations
BROWSER_POOL_SIZE=5

## === LLM / AI Features (optional) ===
# Add for LLM-dependent features (JSON extraction, summary, image alt generation, etc.)
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# MODEL_NAME=
# OLLAMA_BASE_URL=

## === Search (optional) ===
# Self-hosted SearXNG instance for /v2/search
# SEARXNG_ENDPOINT=
# SEARXNG_ENGINES=
# SEARXNG_CATEGORIES=

## === Admin & Queue UI ===
BULL_AUTH_KEY=@
# Optional second bearer value accepted on /admin/ops/* while callers move to a new BULL_AUTH_KEY
# BULL_AUTH_KEY_PREVIOUS=
# Set to true to keep the old /admin/<BULL_AUTH_KEY>/... routes for callers not yet on /admin/ops/*
# BULL_AUTH_KEY_PATH_ROUTES=false
# Optional port for an internal listener serving the queue UI, metrics and diagnostic routes with no key; keep it private
# ADMIN_INTERNAL_PORT=
# Address the internal listener binds to; widen it only behind a network policy
# ADMIN_INTERNAL_HOST=localhost

## === Proxy Settings for Playwright (optional) ===
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
# Set if you'd like to block media requests to save proxy bandwidth
BLOCK_MEDIA=

## === Self-hosted Webhooks (optional) ===
# Set this to the URL of your webhook when using the self-hosted version of Firecrawl
SELF_HOSTED_WEBHOOK_URL=
# Set this to the HMAC secret of your webhook when using the self-hosted version of Firecrawl
SELF_HOSTED_WEBHOOK_HMAC_SECRET=
# Set to true to allow webhooks targeting localhost / private addresses
# ALLOW_LOCAL_WEBHOOKS=false

## === Parse Uploads (optional) ===
# PARSE_UPLOAD_STORAGE_DRIVER=local
# PARSE_UPLOAD_REF_SECRET=
# PARSE_UPLOAD_PUBLIC_BASE_URL=

## === Wikipedia Enterprise API (optional) ===
# WIKIPEDIA_ENTERPRISE_USERNAME=
# WIKIPEDIA_ENTERPRISE_PASSWORD=

## === Testing (optional) ===
TEST_API_KEY=

## === Logging ===
# LOGGING_LEVEL determines the verbosity of logs that the system will output.
# Available levels are: NONE, ERROR, WARN, INFO, DEBUG, TRACE.
LOGGING_LEVEL=INFO

## === OpenTelemetry (optional) ===
# Set an OTLP endpoint to export traces (http/protobuf, 100% sampled). Spans from
# zero-data-retention requests are never exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=firecrawl-api
