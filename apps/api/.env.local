NUM_WORKERS_PER_QUEUE=8
PORT=3002
HOST=0.0.0.0

# Redis — local instance
REDIS_URL=redis://localhost:6379
REDIS_RATE_LIMIT_URL=redis://localhost:6379

# Playwright microservice — local instance (start separately with: cd apps/playwright-service-ts && pnpm start)
PLAYWRIGHT_MICROSERVICE_URL=http://localhost:3000/scrape

# Auth
USE_DB_AUTHENTICATION=false
BULL_AUTH_KEY=@
TEST_API_KEY=fc-b6592fd7bdef4e238c843d11a91c66b7

# NuQ queue backend — local PostgreSQL + RabbitMQ (bypasses harness container management)
NUQ_DATABASE_URL=postgresql://postgres:firecrawl@localhost:5432/postgres
NUQ_DATABASE_URL_LISTEN=postgresql://postgres:firecrawl@localhost:5432/postgres
NUQ_RABBITMQ_URL=amqp://localhost:5672

# PostgreSQL connection details
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=firecrawl

# AI features (fill in to enable LLM-dependent features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (leave blank for local dev without DB auth)
SUPABASE_ANON_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_TOKEN=

# Performance
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5

# Optional
SCRAPING_BEE_API_KEY=
LOGTAIL_KEY=
SEARCHAPI_API_KEY=
LLAMAPARSE_API_KEY=
SLACK_WEBHOOK_URL=
