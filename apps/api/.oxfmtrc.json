{
  "trailingComma": "all",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "printWidth": 80,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    "native/**",
    "sharedLibs/**",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "src/__tests__/snips/mocks/**",
    "**/*.toml"
  ]
}
