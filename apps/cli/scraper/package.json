    "ink": "8.0.0",
    "jsdom": "29.1.1",
    "p-limit": "7.3.0",
    "playwright": "1.59.1",
    "react": "19.3.1",
    "turndown": "7.2.4",
    "yaml": "2.8.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/cli-progress": "3.11.6",
    "@types/jsdom": "28.0.1",
    "@types/node": "25.6.1",
    "@types/react": "19.3.0",
    "@types/turndown": "5.0.6",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
