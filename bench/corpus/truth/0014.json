  },
  {
   "kind": "mid",
   "text": "which finds the ten places closest to a given target point",
   "where": "p < div#INDEXES-TYPE-GIST.sect2 < div#INDEXES-TYPES.sect1 < div#docContent < div#pgContentWrap.col-11"
  },
  {
   "kind": "late",
